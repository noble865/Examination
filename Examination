-- Lógica ESP Player (Corrigida para Respawn)
local espEnabled = false
local highlights = {}

local function removeHighlight(plr)
	if highlights[plr] then
		highlights[plr]:Destroy()
		highlights[plr] = nil
	end
end

local function applyPlayerESP(plr)
	if not espEnabled or plr == Player then return end
	local character = plr.Character
	if not character then return end
	
	-- Se já houver um highlight ativo no personagem atual, não cria outro
	if highlights[plr] and highlights[plr].Parent == character then return end
	
	removeHighlight(plr)

	local hl = Instance.new("Highlight")
	hl.Name = "ShizukaESP"
	hl.FillColor = Color3.fromRGB(0, 139, 139)
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.5
	hl.Parent = character
	highlights[plr] = hl
end

local function setupPlayer(plr)
	if plr == Player then return end
	
	plr.CharacterAdded:Connect(function(char)
		task.wait(0.2) -- Aguarda carregamento do novo modelo ao renascer
		removeHighlight(plr)
		if espEnabled then
			applyPlayerESP(plr)
		end
	end)
end

for _, plr in ipairs(Players:GetPlayers()) do
	setupPlayer(plr)
end
Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(plr)
	removeHighlight(plr)
end)

EspButton.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	if espEnabled then
		EspButton.Text = "  ESP Player: [ ON ]"
		EspButton.TextColor3 = Color3.fromRGB(80, 255, 80)
		for _, plr in ipairs(Players:GetPlayers()) do
			applyPlayerESP(plr)
		end
	else
		EspButton.Text = "  ESP Player: [ OFF ]"
		EspButton.TextColor3 = Color3.fromRGB(200, 200, 200)
		for plr, _ in pairs(highlights) do
			removeHighlight(plr)
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= Player and plr.Character then
				if not highlights[plr] or highlights[plr].Parent ~= plr.Character then
					applyPlayerESP(plr)
				end
			end
		end
	end
end)

-- Lógica ESP Mobs
local mobEspEnabled = false

local function clearMobESP()
	local charsFolder = workspace:FindFirstChild("Characters")
	if not charsFolder then return end
	for _, v in ipairs(charsFolder:GetChildren()) do
		local hl = v:FindFirstChild("AI_Highlight")
		local ui = v:FindFirstChild("AI_HealthUI")
		if hl then hl:Destroy() end
		if ui then ui:Destroy() end
	end
end

local function highlightAI(v)
	if not mobEspEnabled or not v:FindFirstChild("AI") then
		local hl = v:FindFirstChild("AI_Highlight")
		local ui = v:FindFirstChild("AI_HealthUI")
		if hl then hl:Destroy() end
		if ui then ui:Destroy() end
		return
	end

	if v:FindFirstChild("AI_Highlight") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "AI_Highlight"
	highlight.Adornee = v
	highlight.FillColor = Color3.fromRGB(255, 0, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 1
	highlight.Parent = v

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "AI_HealthUI"
	billboard.Adornee = v
	billboard.Size = UDim2.new(0, 100, 0, 25)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 150
	billboard.Parent = v

	local textLabel = Instance.new("TextLabel")
	textLabel.Parent = billboard
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
	textLabel.TextStrokeTransparency = 0
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.SourceSansBold

	task.spawn(function()
		local humanoid = v:FindFirstChildOfClass("Humanoid")
		while mobEspEnabled and v and v.Parent and humanoid do
			if humanoid.Health <= 0 then
				if highlight then highlight:Destroy() end
				if billboard then billboard:Destroy() end
				break
			end
			textLabel.Text = math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth)
			task.wait(0.2)
		end
	end)
end

local function updateMobESPState()
	local charsFolder = workspace:FindFirstChild("Characters")
	if not charsFolder then return end

	if mobEspEnabled then
		for _, v in ipairs(charsFolder:GetChildren()) do
			if v:FindFirstChild("AI") then
				highlightAI(v)
			end
		end
	else
		clearMobESP()
	end
end

task.spawn(function()
	local charsFolder = workspace:WaitForChild("Characters", 10)
	if charsFolder then
		charsFolder.ChildAdded:Connect(function(v)
			task.wait(0.1)
			if mobEspEnabled and v:FindFirstChild("AI") then
				highlightAI(v)
			end
		end)
	end
end)

EspMobsButton.MouseButton1Click:Connect(function()
	mobEspEnabled = not mobEspEnabled
	if mobEspEnabled then
		EspMobsButton.Text = "  ESP Mobs: [ ON ]"
		EspMobsButton.TextColor3 = Color3.fromRGB(80, 255, 80)
	else
		EspMobsButton.Text = "  ESP Mobs: [ OFF ]"
		EspMobsButton.TextColor3 = Color3.fromRGB(200, 200, 200)
	end
	updateMobESPState()
end)


-- ESP Player
local espEnabled = false
local highlights = {}

local function removeHighlight(plr)
	if highlights[plr] then
		highlights[plr]:Destroy()
		highlights[plr] = nil
	end
end

local function applyPlayerESP(plr)
	if not espEnabled or plr == Player then return end
	local character = plr.Character
	if not character then return end
	if highlights[plr] and highlights[plr].Parent == character then return end
	
	removeHighlight(plr)

	local hl = Instance.new("Highlight")
	hl.Name = "ShizukaESP"
	hl.FillColor = TACTICAL_ORANGE
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.5
	hl.Parent = character
	highlights[plr] = hl
end

local function setupPlayer(plr)
	if plr == Player then return end
	plr.CharacterAdded:Connect(function()
		task.wait(0.2)
		removeHighlight(plr)
		if espEnabled then applyPlayerESP(plr) end
	end)
end

for _, plr in ipairs(Players:GetPlayers()) do setupPlayer(plr) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(removeHighlight)

createTile(MainPage, "ESP Player", "ESP_PLR", "Escaneia e rastreia o contorno de todos os jogadores ativos através das estruturas.", function(active)
	espEnabled = active
	if espEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do applyPlayerESP(plr) end
	else
		for plr, _ in pairs(highlights) do removeHighlight(plr) end
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= Player and plr.Character then
				if not highlights[plr] or highlights[plr].Parent ~= plr.Character then
					applyPlayerESP(plr)
				end
			end
		end
	end
end)

-- ESP Mobs
local mobEspEnabled = false

local function clearMobESP()
	local charsFolder = workspace:FindFirstChild("Characters")
	if not charsFolder then return end
	for _, v in ipairs(charsFolder:GetChildren()) do
		local hl = v:FindFirstChild("AI_Highlight")
		local ui = v:FindFirstChild("AI_HealthUI")
		if hl then hl:Destroy() end
		if ui then ui:Destroy() end
	end
end

local function highlightAI(v)
	if not mobEspEnabled or not v:FindFirstChild("AI") then return end
	if v:FindFirstChild("AI_Highlight") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "AI_Highlight"
	highlight.Adornee = v
	highlight.FillColor = Color3.fromRGB(255, 30, 30)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.Parent = v

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "AI_HealthUI"
	billboard.Adornee = v
	billboard.Size = UDim2.new(0, 100, 0, 25)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 150
	billboard.Parent = v

	local textLabel = Instance.new("TextLabel")
	textLabel.Parent = billboard
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.GothamBold

	task.spawn(function()
		local humanoid = v:FindFirstChildOfClass("Humanoid")
		while mobEspEnabled and v and v.Parent and humanoid do
			if humanoid.Health <= 0 then
				if highlight then highlight:Destroy() end
				if billboard then billboard:Destroy() end
				break
			end
			textLabel.Text = math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth)
			task.wait(0.2)
		end
	end)
end

createTile(MainPage, "ESP Mobs", "ESP_MOB", "Identifica hostis e NPCs no mapa, exibindo barra de vida e localização em tempo real.", function(active)
	mobEspEnabled = active
	local charsFolder = workspace:FindFirstChild("Characters")
	if mobEspEnabled and charsFolder then
		for _, v in ipairs(charsFolder:GetChildren()) do
			if v:FindFirstChild("AI") then highlightAI(v) end
		end
	else
		clearMobESP()
	end
end)


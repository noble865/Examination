-- Configurações e Animação de Zoom
local fullSize = UDim2.new(0, 620, 0, 380)
local zeroSize = UDim2.new(0, 0, 0, 0)

local zoomInInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local zoomOutInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

local function toggleUI(isOpen)
	if isOpen then
		OpenButton.Visible = false
		MainFrame.Size = zeroSize
		MainFrame.Visible = true
		
		TweenService:Create(MainFrame, zoomInInfo, {
			Size = fullSize
		}):Play()
	else
		local tw = TweenService:Create(MainFrame, zoomOutInfo, {
			Size = zeroSize
		})
		tw:Play()
		tw.Completed:Connect(function()
			MainFrame.Visible = false
			OpenButton.Visible = true
		end)
	end
end

CloseButton.MouseButton1Click:Connect(function() toggleUI(false) end)
OpenButton.MouseButton1Click:Connect(function() toggleUI(true) end)

-- Escutador de Teclas do Teclado
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isBinding or isBindingTP then return end
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == toggleKey then

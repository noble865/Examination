local function createTile(parent, name, code, description, onClick)
	local tile = Instance.new("TextButton")
	tile.BackgroundColor3 = TILE_BG
	tile.Text = ""
	tile.Parent = parent
	
	local tileStroke = Instance.new("UIStroke")
	tileStroke.Color = BORDER_COLOR
	tileStroke.Thickness = 1
	tileStroke.Parent = tile
	
	local accentBar = Instance.new("Frame")
	accentBar.Size = UDim2.new(0, 4, 1, 0)
	accentBar.BackgroundColor3 = BORDER_COLOR
	accentBar.BorderSizePixel = 0
	accentBar.Parent = tile
	
	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(1, -15, 0, 25)
	titleLbl.Position = UDim2.new(0, 12, 0, 8)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = name
	titleLbl.TextColor3 = TEXT_WHITE
	titleLbl.TextSize = 12
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = tile
	
	local statusBadge = Instance.new("TextLabel")
	statusBadge.Size = UDim2.new(1, -15, 0, 20)
	statusBadge.Position = UDim2.new(0, 12, 1, -25)
	statusBadge.BackgroundTransparency = 1
	statusBadge.Text = "[ OFF ]"
	statusBadge.TextColor3 = TEXT_MUTED
	statusBadge.TextSize = 10
	statusBadge.Font = Enum.Font.Gotham
	statusBadge.TextXAlignment = Enum.TextXAlignment.Left
	statusBadge.Parent = tile
	
	local state = false
	
	tile.MouseEnter:Connect(function()
		updateDetails(name, description)
	end)
	
	tile.MouseButton1Click:Connect(function()
		state = not state
		if state then
			tile.BackgroundColor3 = Color3.fromRGB(35, 25, 18)
			tileStroke.Color = TACTICAL_ORANGE
			accentBar.BackgroundColor3 = TACTICAL_ORANGE
			statusBadge.Text = "[ ACTIVE ]"
			statusBadge.TextColor3 = TACTICAL_ORANGE
		else
			tile.BackgroundColor3 = TILE_BG
			tileStroke.Color = BORDER_COLOR
			accentBar.BackgroundColor3 = BORDER_COLOR
			statusBadge.Text = "[ OFF ]"
			statusBadge.TextColor3 = TEXT_MUTED
		end
		if onClick then onClick(state, statusBadge, tile) end
	end)
	
	return tile, statusBadge
end

